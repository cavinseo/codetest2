generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  name                String?
  passwordHash        String
  // 가입 직후에는 PENDING. 관리자가 승인해야 로그인할 수 있다.
  status              String                 @default("PENDING")
  isAdmin             Boolean                @default(false)
  // 시스템 역할: ADMIN | PROGRAM_MANAGER | MENTOR | MENTEE
  // 프로젝트 단위 역할(ProjectMember.role)과는 별개다. 이쪽은 "이 사람이 무엇을
  // 할 수 있는가", 저쪽은 "이 프로젝트에서 무엇을 할 수 있는가"를 정한다.
  role                String                 @default("MENTEE")
  // 초대 코드로 가입한 계정의 접근 만료 시각. null 이면 만료 없음(관리자 생성 계정).
  accessExpiresAt     DateTime?
  // 발급된 세션을 한꺼번에 무효화하기 위한 값. 비밀번호 변경이나 승인 취소 때
  // 1 올리면, 그 전에 발급된 쿠키는 전부 거부된다.
  sessionVersion      Int                    @default(0)
  // 관리자가 만든 계정은 임시 비밀번호를 받는다. 이 값이 true 인 동안에는
  // 비밀번호를 바꾸기 전까지 다른 화면으로 넘어가지 못한다.
  mustChangePassword  Boolean                @default(false)
  // 멘티가 속한 프로그램. 프로그램 전용 초대 코드로 가입할 때 그 코드의
  // 프로그램으로 정해진다. 멘토·매니저·관리자에게는 의미가 없다(null).
  // 프로그램이 지워져도 계정 자체는 남아야 하므로 SetNull.
  programId           String?
  program             Program?               @relation("ProgramMentees", fields: [programId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  kanoInvitationsSent KanoSurveyInvitation[]
  migrations          MigrationHistory[]
  projectMemberships  ProjectMember[]
  ownedProjects       Project[]              @relation("ProjectOwner")
  managedPrograms     Program[]              @relation("ProgramManager")
  issuedInviteCodes   InviteCode[]           @relation("InviteIssuer")
  usedInviteCode      InviteCode?            @relation("InviteRedeemer")
  profile             MemberProfile?
  aiConnection        UserAiConnection?

  @@map("users")
}

/// 기관(기업) 단위로 개설하는 주제별 단위. 프로그램 매니저나 관리자가 만든다.
/// 하나의 프로그램은 그 프로그램에 참여하는 멘티들의 KS-QFD 프로젝트로 구성된다.
model Program {
  id           String   @id @default(cuid())
  /// 프로그램명
  name         String
  /// 주관기관명(기업·기관)
  organization String
  /// 운영 기간
  startsAt     DateTime
  endsAt       DateTime
  /// 이 프로그램을 개설한 프로그램 매니저(또는 관리자).
  /// Restrict 인 이유: 사람 하나를 지우는 것으로 기관 단위 프로그램과 그 아래
  /// 멘티들의 작업물이 통째로 사라지면 안 된다. 먼저 담당자를 옮겨야 한다.
  managerId    String
  manager      User     @relation("ProgramManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects    Project[]
  inviteCodes InviteCode[]
  mentees     User[]       @relation("ProgramMentees")

  @@index([managerId])
  @@map("programs")
}

model Project {
  id                       String                    @id @default(cuid())
  name                     String
  description              String?
  ownerId                  String
  /// 이 프로젝트가 속한 프로그램. Restrict 인 이유는 Program.managerId 와 같다.
  /// 프로그램을 지우려면 그 안의 프로젝트를 먼저 정리해야 한다.
  programId                String
  program                  Program                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  businessPlanFile         String?
  detailedDescription      String?
  // AI 에이전트 연결 방식: "rule"(규칙 기반만) | "local"(로컬 LLM 우선, 실패 시 폴백)
  aiMode                   String                    @default("rule")
  attributeFitnesses       AttributeFitness[]
  benchmarks               Benchmark[]
  requirements             CustomerRequirement[]
  kanoResponses            KanoResponse[]
  kanoInvitations          KanoSurveyInvitation[]
  migrations               MigrationHistory[]
  productAttributes        ProductAttribute[]
  members                  ProjectMember[]
  owner                    User                      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  qfdMatrices              QFDMatrix[]
  specFunctions            SpecFunction[]
  techCorrelations         TechCorrelation[]
  technicalCharacteristics TechnicalCharacteristic[]
  fitnessMatrix            FitnessMatrix?
  techTreeEntries          TechTreeEntry[]
  improvementItems         ImprovementItem[]
  targetSpecs              TargetSpec[]
  techRoadmaps             TechRoadmap[]
  devPlans                 DevPlan[]
  salesEstimates           SalesEstimate[]
  assetItems               AssetItem[]
  fundingPlans             FundingPlan[]
  fundingSources           FundingSource[]

  @@index([ownerId])
  @@index([programId])
  @@map("projects")
}

// ... (기존 모델들 보존) ...

// ─────────────────────────────────────────
// 핵심자산과 보완자산 (AssetsTable)
// ─────────────────────────────────────────
model AssetItem {
  id        String  @id @default(cuid())
  projectId String
  type      String  // "CORE" | "COMPLEMENTARY"
  category  String? // 핵심: (공란), 보완: "필요 항목"
  content   String? // 핵심: "핵심자산", 보완: "해결방안"
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("asset_items")
}

// ─────────────────────────────────────────
// 자금소요계획 (FundingReqTable)
// ─────────────────────────────────────────
model FundingPlan {
  id        String  @id @default(cuid())
  projectId String
  category  String? // "매출액", "소요자금"
  item      String? // "매출액", "생산비용", "운영관리비" 등
  year1     Float   @default(0)
  year2     Float   @default(0)
  year3     Float   @default(0)
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("funding_plans")
}

// ─────────────────────────────────────────
// 자금조달계획 (FundingSourceTable)
// ─────────────────────────────────────────
model FundingSource {
  id        String  @id @default(cuid())
  projectId String
  category  String? // "정부자금", "엔젤투자금" 등
  year1     String? // "출처:금액" 또는 JSON 형태 저장 가능성 고려하여 String
  year2     String?
  year3     String?
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("funding_sources")
}

model ProjectMember {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  role      String
  invitedBy String?
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model SpecFunction {
  id         String  @id @default(cuid())
  projectId  String
  level      String
  parentId   String?
  name       String
  technology String?
  order      Int     @default(0)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("spec_functions")
}

model CustomerRequirement {
  id             String         @id @default(cuid())
  projectId      String
  category       String
  subcategory    String?
  requirement    String
  kanoPositiveQ  String?        // Kano 긍정 질문 (사용자 직접 입력)
  kanoNegativeQ  String?        // Kano 부정 질문 (사용자 직접 입력)
  kanoWeight     Float?
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  benchmarks     Benchmark[]
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kanoResponses  KanoResponse[]
  qfdMatrices    QFDMatrix[]

  @@index([projectId])
  @@map("customer_requirements")
}

model TechnicalCharacteristic {
  id            String            @id @default(cuid())
  projectId     String
  name          String
  unit          String?
  targetValue   String?
  qfdMatrices   QFDMatrix[]
  correlations2 TechCorrelation[] @relation("Tech2")
  correlations1 TechCorrelation[] @relation("Tech1")
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("technical_characteristics")
}

model KanoSurveyInvitation {
  id          String         @id @default(cuid())
  projectId   String
  email       String
  token       String         @unique
  invitedBy   String
  expiresAt   DateTime
  respondedAt DateTime?
  isUsed      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  responses   KanoResponse[]
  inviter     User           @relation(fields: [invitedBy], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([token])
  @@map("kano_survey_invitations")
}

model KanoResponse {
  id              String               @id @default(cuid())
  projectId       String
  requirementId   String
  invitationId    String
  respondentEmail String
  positiveAnswer  Int
  negativeAnswer  Int
  kanoCategory    String
  respondedAt     DateTime             @default(now())
  invitation      KanoSurveyInvitation @relation(fields: [invitationId], references: [id])
  requirement     CustomerRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([requirementId])
  @@index([invitationId])
  @@map("kano_responses")
}

model QFDMatrix {
  id              String                  @id @default(cuid())
  projectId       String
  requirementId   String
  technicalCharId String
  strength        String
  currentScore    Float?
  competitorScore Float?
  techChar        TechnicalCharacteristic @relation(fields: [technicalCharId], references: [id], onDelete: Cascade)
  requirement     CustomerRequirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, requirementId, technicalCharId])
  @@map("qfd_matrices")
}

model ProductAttribute {
  id             String             @id @default(cuid())
  projectId      String
  productName    String?
  customerName   String?
  marketSegment  String?
  customerNeed   String?
  benefit        String?
  attribute      String?
  techCapability String?
  order          Int                @default(0)
  fitnesses      AttributeFitness[]
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("product_attributes")
}

model AttributeFitness {
  id           String           @id @default(cuid())
  projectId    String
  attributeId  String
  importance   Int              @default(0)
  currentLevel Int              @default(0)
  targetLevel  Int              @default(0)
  note         String?
  attribute    ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([attributeId])
  @@map("attribute_fitnesses")
}

model TechCorrelation {
  id          String                  @id @default(cuid())
  projectId   String
  techId1     String
  techId2     String
  correlation String
  tech2       TechnicalCharacteristic @relation("Tech2", fields: [techId2], references: [id], onDelete: Cascade)
  tech1       TechnicalCharacteristic @relation("Tech1", fields: [techId1], references: [id], onDelete: Cascade)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, techId1, techId2])
  @@map("tech_correlations")
}

model Benchmark {
  id            String              @id @default(cuid())
  projectId     String
  requirementId String
  company       String
  score         Int                 @default(0)
  requirement   CustomerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, requirementId, company])
  @@map("benchmarks")
}

model MigrationHistory {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  fileName       String
  fileSize       Int
  sheetsMigrated String
  status         String
  errorLog       String?
  migratedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("migration_histories")
}

// ─────────────────────────────────────────
// 적합도 매트릭스 (FitnessWrapper)
// ─────────────────────────────────────────
model FitnessMatrix {
  id             String   @id @default(cuid())
  projectId      String   @unique
  marketsJson    String
  matrixJson     String
  managerComment String?
  consultantNote String?
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("fitness_matrices")
}

// ─────────────────────────────────────────
// 기능기술체계 (TechTreeTable)
// ─────────────────────────────────────────
model TechTreeEntry {
  id                 String  @id @default(cuid())
  projectId          String
  customerVoice      String?
  coreSpec           String?
  subSpec            String?
  techCharacteristic String?
  order              Int     @default(0)
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tech_tree_entries")
}

// ─────────────────────────────────────────
// 개선포인트 (ImprovementsTable)
// ─────────────────────────────────────────
model ImprovementItem {
  id              String  @id @default(cuid())
  projectId       String
  type            String  // "need" | "feature"
  content         String?
  improvementRate String?
  devProportion   String?
  priority        String?
  order           Int     @default(0)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("improvement_items")
}

// ─────────────────────────────────────────
// 목표사양 (TargetSpecTable)
// ─────────────────────────────────────────
model TargetSpec {
  id              String  @id @default(cuid())
  projectId       String
  category        String?
  subCategory     String?
  specItem        String?
  unit            String?
  currentValue    String?
  competitorValue String?
  targetValue     String?
  note            String?
  order           Int     @default(0)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("target_specs")
}

// ─────────────────────────────────────────
// 기술로드맵 (TechRoadmapTable)
// ─────────────────────────────────────────
model TechRoadmap {
  id           String  @id @default(cuid())
  projectId    String
  category     String?
  techItem     String?
  currentLevel String?
  q1           String?
  q2           String?
  q3           String?
  q4           String?
  targetLevel  String?
  owner        String?
  order        Int     @default(0)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tech_roadmaps")
}

// ─────────────────────────────────────────
// 개발계획 (DevPlanTable)
// ─────────────────────────────────────────
model DevPlan {
  id          String  @id @default(cuid())
  projectId   String
  phase       String?
  task        String?
  description String?
  startDate   String?
  endDate     String?
  owner       String?
  status      String  @default("미시작")
  order       Int     @default(0)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("dev_plans")
}

// ─────────────────────────────────────────
// 매출추정 (SalesTable)
// ─────────────────────────────────────────
model SalesEstimate {
  id         String  @id @default(cuid())
  projectId  String
  period     String  @default("Y")
  customer   String?
  amount     Float   @default(0)
  futureAmount Float @default(0)
  competitor String?
  order      Int     @default(0)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("sales_estimates")
}

// 서비스 전역 설정(Google OAuth, SMTP, AI 엔진).
// 예전에는 globalThis 메모리에만 있어서 서버리스 콜드스타트마다 사라졌다.
// 시크릿이 포함되므로 value 는 암호화해서 넣는다(lib/settings-crypto.ts).
model ServiceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("service_settings")
}

// 멘토·멘티를 초대하기 위한 1회용 코드. 신청 이메일로 발송한다.
model InviteCode {
  id String @id @default(cuid())
  // 이메일로 보내는 값. 조회 키라 유니크하다.
  code  String @unique
  // 이 코드를 쓸 수 있는 이메일. 다른 주소로는 가입할 수 없다.
  email String
  // 가입 시 부여할 시스템 역할. 지금은 MENTEE 만 발급한다(멘토는 정식 등록).
  // 과거에 발급된 MENTOR 코드가 남아 있어 컬럼은 그대로 둔다.
  role  String
  // 이 코드로 들어온 멘티가 참여할 프로그램. 코드는 이 프로그램에만 쓸 수 있다.
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  // 코드 자체의 사용 기한
  expiresAt DateTime
  // 가입 후 부여할 접근 기간(일). 기본 90일(약 3개월).
  accessDurationDays Int @default(90)

  issuedById String
  issuedBy   User   @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: Cascade)

  usedAt     DateTime?
  usedById   String?   @unique
  usedBy     User?     @relation("InviteRedeemer", fields: [usedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([issuedById])
  @@index([programId])
  @@map("invite_codes")
}

// 회원등록 정보. 인증에 쓰이는 users 행과 분리해 둔다.
// requireAuth 가 매 요청마다 users 를 읽으므로 관심사를 섞지 않는다.
model MemberProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 공통
  // 소속기관명
  organization String
  // 직책·직위
  jobTitle     String?
  // 휴대폰
  phone        String

  // 멘토·프로그램 매니저
  expertise     String? // 전문분야
  careerYears   Int?    // 경력 연수
  careerSummary String? // 주요이력·보유자격

  // 멘티
  companyName String? // 기업명
  industry    String? // 업종
  foundedYear Int?    // 창업 연차

  // 개인정보 수집·이용 동의 시각
  privacyConsentAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_profiles")
}

/// 회원이 등록한 개인 AI 키. 본인의 AI 작업에만 쓰이고 절대 공유되지 않는다.
/// apiKey 는 lib/settings-crypto 로 암호화된 값(enc:v1: 접두)만 저장한다.
model UserAiConnection {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'openai' | 'anthropic' | 'gemini' — lib/ai/personal-vendors.ts 가 정본
  vendor    String
  apiKey    String
  // 비우면 벤더 기본 모델을 쓴다
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_ai_connections")
}
