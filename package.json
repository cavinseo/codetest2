{
    "name": "kano-qfd-webapp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "check:encoding": "node scripts/check-text-encoding.mjs",
        "pretest": "npm run check:encoding",
        "prebuild": "npm run check:encoding",
        "build": "prisma generate && next build",
        "start": "next start",
        "test": "vitest run --pool=threads",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "bcryptjs": "^2.4.3",
        "exceljs": "^4.4.0",
        "next": "^15.1.6",
        "nodemailer": "^8.0.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "autoprefixer": "^10.4.20",
        "eslint": "^9",
        "eslint-config-next": "^15.1.6",
        "postcss": "^8",
        "prisma": "^6.19.2",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "vitest": "^4.1.5"
    }
}
