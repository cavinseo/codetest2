# 환경 변수 설정

# PostgreSQL 접속 문자열. Supabase 를 사용하며 두 값 모두 필요하다.
# POSTGRES_PRISMA_URL      : 커넥션 풀러 경유(앱 런타임용)
# POSTGRES_URL_NON_POOLING : 직접 연결(마이그레이션·대량 삽입용)
# Vercel 에 Supabase 통합을 연결했다면 `vercel env pull` 로 실제 값을 받아올 수 있다.
# 실제 값은 각자 .env 에 넣고, 이 예제 파일에는 자리표시자만 둔다.
POSTGRES_PRISMA_URL="postgresql://USER:CHANGE_ME@HOST:5432/postgres?schema=public&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:CHANGE_ME@HOST:5432/postgres?schema=public"

# 통합 테스트(npm run test:integration) 전용 접속 문자열이다. 이 스위트는 실제로 행을
# 만들고 지우므로 앱이 쓰는 POSTGRES_PRISMA_URL 과는 완전히 분리된, 버려도 되는 테스트
# 전용 DB를 가리켜야 한다. 값이 비어 있거나 POSTGRES_PRISMA_URL 과 같으면 통합 테스트가
# 시작하자마자 실패한다.
# INTEGRATION_DATABASE_URL="postgresql://USER:CHANGE_ME@HOST:5432/postgres_test?schema=public"

# 세션 서명 키 (32자 이상 권장). SESSION_SECRET 이 없으면 NEXTAUTH_SECRET 을 사용한다.
SESSION_SECRET="your-session-signing-secret-change-in-production"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# 초대 메일 링크 등에 쓰이는 서비스 기준 URL
NEXTAUTH_URL="http://localhost:3000"

# 관리자 이메일 허용 목록 (쉼표 구분)
ADMIN_EMAILS="admin@example.com"

# 비프로덕션에서 관리자 권한 우회 허용 여부. 배포 환경에서는 반드시 false 로 둔다.
ALLOW_DEV_ADMIN="false"

# SMTP(Nodemailer)와 Google OAuth 자격 증명은 환경 변수가 아니라
# 앱의 설정 화면(/settings, /api/settings)에서 등록한다.

# ─────────────────────────────────────────
# AI 멘토링 엔진
# ─────────────────────────────────────────
# 사용할 엔진: rule | local | hermes | api
#   rule   : 규칙 기반. 외부 의존성이 없어 항상 동작하며 다른 엔진 실패 시 폴백으로 쓰인다.
#   local  : 로컬 OpenAI 호환 서버(Ollama, LM Studio 등)
#   hermes : 헤르메스 에이전트가 설치된 경우
#   api    : 클라우드 LLM API (최종 완성 단계용)
# local/hermes 는 사용자 PC에서만 도달 가능하므로 Vercel 배포 환경에서는 rule 또는 api 만 동작한다.
AI_PROVIDER="rule"

# 아래 주소·모델 값은 모두 선택 사항이다. 비워 두면 알려진 포트를 순서대로 두드려
# 실제로 응답하는 엔드포인트와 설치된 모델을 자동으로 찾는다.
# 엔진 선택과 주소는 앱의 설정 화면(/settings > AI 엔진)에서도 바꿀 수 있다.

# 로컬 AI. 자동 탐지 순서: 11434(Ollama) -> 1234(LM Studio) -> 8000(vLLM)
# 보안상 localhost 계열 주소만 허용된다.
AI_LOCAL_BASE_URL="http://localhost:11434/v1"
AI_LOCAL_MODEL=""

# 헤르메스 에이전트. OpenAI 호환 엔드포인트로 가정한다.
# 자동 탐지 순서: 8080(자체 서버) -> 11434(Ollama) -> 1234(LM Studio)
# 모델을 비워 두면 이름에 hermes 가 들어간 모델을 골라 쓴다.
HERMES_BASE_URL="http://localhost:8080/v1"
HERMES_MODEL=""

# 클라우드 API (최종 단계에서 사용)
AI_API_BASE_URL=""
AI_API_MODEL=""
AI_API_KEY=""

# 로컬/헤르메스 엔드포인트가 API 키를 요구하는 경우에만 채운다.
# 대부분의 Ollama, LM Studio 구성에서는 비워 둔다.
AI_LOCAL_API_KEY=""
HERMES_API_KEY=""

# true 로 두면 서버측 로컬 AI 탐색을 건너뛰고 곧바로 브라우저 경유로 넘어간다.
# 서버에서 localhost LLM 에 닿을 수 없는 배포 환경(Vercel 등)에서 탐색 지연을 없앤다.
AI_LOCAL_SERVER_DISABLED=""

# 서비스 설정(Google/SMTP 자격증명)을 DB 에 암호화해 저장할 때 쓰는 키.
# 비워 두면 SESSION_SECRET 에서 파생하는데, 그 경우 SESSION_SECRET 을 교체하면
# 저장해 둔 설정을 다시 입력해야 한다. 운영에서는 따로 지정하는 편이 좋다.
SETTINGS_ENCRYPTION_KEY=""
